  "defect_classes": {
    "condition": "tests detect look-ahead, same-close fill, split/dividend, delisting, stale-price, cash, rounding, fee, slippage, rejected-order, and duplicate-order errors",
    "declared_class_count": 12,
    "classes": [
      {
        "id": "LOOK_AHEAD",
        "mutation": "a probe asks the market view for a bar at or after the session following the decision session",
        "detector": "LookAheadError raised by the market view, which is constructed with a hard visibility bound and cannot be widened by the caller",
        "tests": [
          "tests/adversarial/test_stage2_defects.py::test_look_ahead_a_probe_reading_tomorrows_bar_is_stopped_by_the_market_view",
          "tests/adversarial/test_stage2_defects.py::test_look_ahead_the_bound_cannot_be_widened_by_the_caller"
        ]
      },
      {
        "id": "SAME_CLOSE_FILL",
        "mutation": "a fill is submitted for the decision session itself rather than the next session",
        "detector": "FillTimingError raised by the order book, which requires fill_session to be strictly after decision_session and to be the next eligible exchange session",
        "tests": [
          "tests/adversarial/test_stage2_defects.py::test_same_close_fill_an_order_filling_at_its_own_decision_close_cannot_be_built",
          "tests/adversarial/test_stage2_defects.py::test_same_close_fill_the_engine_refuses_to_execute_one_that_reached_it_anyway",
          "tests/adversarial/test_stage2_defects.py::test_same_close_fill_the_real_entry_fills_at_the_next_sessions_open"
        ]
      },
      {
        "id": "SPLIT",
        "mutation": "share count multiplied by the recorded split ratio on the split session",
        "detector": "value-continuity invariant across every corporate-action session: marked position value may not jump by the split ratio; CorporateActionError",
        "tests": [
          "tests/adversarial/test_stage2_defects.py::test_split_multiplying_the_share_count_on_a_split_session_is_caught",
          "tests/adversarial/test_stage2_defects.py::test_split_a_series_that_is_not_actually_split_adjusted_is_caught"
        ]
      },
      {
        "id": "DIVIDEND",
        "mutation": "credit the dividend on the session after the ex-date, and separately credit it twice",
        "detector": "benchmark reconciliation between the provider adjustment factor and the explicit reinvestment model, plus a per-event cash-credit assertion in the fixture",
        "tests": [
          "tests/adversarial/test_stage2_defects.py::test_dividend_the_ex_date_cash_credit_matches_the_hand_calculation",
          "tests/adversarial/test_stage2_defects.py::test_dividend_crediting_on_the_session_after_the_ex_date_is_caught",
          "tests/adversarial/test_stage2_defects.py::test_dividend_crediting_twice_is_caught_by_the_per_event_cash_assertion",
          "tests/adversarial/test_stage2_defects.py::test_dividend_a_wrong_amount_shows_up_in_the_benchmark_reconciliation"
        ]
      },
      {
        "id": "DELISTING",
        "mutation": "extend the run beyond a symbol's last session while holding it, without liquidating",
        "detector": "the engine liquidates at the last available close and marks the symbol ineligible; DelistingError if a position survives its symbol's final session",
        "tests": [
          "tests/adversarial/test_stage2_defects.py::test_delisting_the_engine_liquidates_at_the_last_available_close",
          "tests/adversarial/test_stage2_defects.py::test_delisting_a_position_carried_past_its_own_final_bar_raises",
          "tests/adversarial/test_stage2_defects.py::test_delisting_an_order_past_the_symbols_final_bar_is_rejected_as_delisted"
        ]
      },
      {
        "id": "STALE_PRICE",
        "mutation": "remove a bar from the middle of a series while the calendar still reports a session",
        "detector": "fills rejected with STALE_PRICE; the equity point flagged stale; a stale run longer than the declared limit raises DataIntegrityHalt",
        "tests": [
          "tests/adversarial/test_stage2_defects.py::test_stale_price_a_fill_on_a_session_with_no_bar_is_rejected",
          "tests/adversarial/test_stage2_defects.py::test_stale_price_an_equity_point_marked_on_an_old_close_is_flagged",
          "tests/adversarial/test_stage2_defects.py::test_stale_price_a_stale_run_past_the_sealed_limit_halts_the_run"
        ]
      },
      {
        "id": "CASH",
        "mutation": "fill an order larger than available cash; skip the cash debit on a fill",
        "detector": "the cash-conservation invariant checked after every event: closing cash equals opening cash minus debits plus credits, exactly, in Decimal; and cash may never be negative",
        "tests": [
          "tests/adversarial/test_stage2_defects.py::test_cash_an_order_larger_than_the_balance_cannot_create_a_position",
          "tests/adversarial/test_stage2_defects.py::test_cash_a_debit_that_never_reached_the_ledger_is_caught",
          "tests/adversarial/test_stage2_defects.py::test_cash_conservation_holds_across_the_whole_clean_run"
        ]
      },
      {
        "id": "ROUNDING",
        "mutation": "round share quantity up instead of down; round a buy notional down instead of up",
        "detector": "the adverse-rounding invariant: for a buy, charged notional is greater than or equal to quantity times effective price; for a sell and for dividend cash, credited amount is less than or equal to it; MIN_NOTIONAL rejection is asserted separately",
        "tests": [
          "tests/adversarial/test_stage2_defects.py::test_rounding_a_quantity_rounded_up_buys_shares_the_budget_does_not_cover",
          "tests/adversarial/test_stage2_defects.py::test_rounding_a_buy_notional_rounded_down_favours_the_account",
          "tests/adversarial/test_stage2_defects.py::test_rounding_every_fill_in_the_clean_run_rounds_adversely",
          "tests/adversarial/test_stage2_defects.py::test_rounding_an_order_below_the_minimum_notional_is_rejected_not_rounded_up"
        ]
      },
      {
        "id": "FEE",
        "mutation": "set every fee to zero; apply the sell-side fees to a buy",
        "detector": "hand-calculated fixture equality on each fee component, plus the invariant that every fill carries a strictly positive total cost",
        "tests": [
          "tests/adversarial/test_stage2_defects.py::test_fee_each_component_matches_the_hand_calculation",
          "tests/adversarial/test_stage2_defects.py::test_fee_zeroing_every_fee_changes_the_answer",
          "tests/adversarial/test_stage2_defects.py::test_fee_the_sell_side_fees_are_never_charged_on_a_buy",
          "tests/adversarial/test_stage2_defects.py::test_fee_every_fill_carries_a_strictly_positive_total_cost"
        ]
      },
      {
        "id": "SLIPPAGE",
        "mutation": "fill a buy below the reference price and a sell above it",
        "detector": "the adverse-price invariant asserted on every fill: effective buy price is strictly greater than the reference, effective sell price is strictly less",
        "tests": [
          "tests/adversarial/test_stage2_defects.py::test_slippage_the_favourable_direction_is_refused_inside_the_price_function",
          "tests/adversarial/test_stage2_defects.py::test_slippage_a_replaced_price_function_is_still_caught_at_the_fill",
          "tests/adversarial/test_stage2_defects.py::test_slippage_omitting_it_entirely_changes_the_fill_price",
          "tests/adversarial/test_stage2_defects.py::test_slippage_every_fill_in_the_clean_run_is_priced_adversely"
        ]
      },
      {
        "id": "REJECTED_ORDER",
        "mutation": "apply the position and cash effect of an order that was rejected",
        "detector": "rejections are recorded with a reason code and asserted to leave cash, position, and equity byte-identical to the pre-order state",
        "tests": [
          "tests/adversarial/test_stage2_defects.py::test_rejected_order_a_rejection_leaves_cash_position_and_equity_untouched",
          "tests/adversarial/test_stage2_defects.py::test_rejected_order_every_rejection_carries_a_declared_reason_code",
          "tests/adversarial/test_stage2_defects.py::test_rejected_order_an_order_with_nowhere_to_fill_is_recorded_rather_than_dropped"
        ]
      },
      {
        "id": "DUPLICATE_ORDER",
        "mutation": "submit an identical order twice on the same session",
        "detector": "DuplicateOrderError from the order book, which rejects a repeated deterministic order id and a second live order in the same symbol on the same session",
        "tests": [
          "tests/adversarial/test_stage2_defects.py::test_duplicate_order_the_identical_order_submitted_twice_is_refused",
          "tests/adversarial/test_stage2_defects.py::test_duplicate_order_a_probe_asking_twice_in_one_session_is_caught",
          "tests/adversarial/test_stage2_defects.py::test_duplicate_order_two_live_orders_in_one_symbol_on_one_session_are_refused",
          "tests/adversarial/test_stage2_defects.py::test_duplicate_order_the_clean_run_admits_no_duplicates"
        ]
      }
    ],
    "clean_controls": [
      "tests/adversarial/test_stage2_defects.py::test_control_the_clean_fixture_run_matches_the_hand_calculation",
      "tests/adversarial/test_stage2_defects.py::test_control_a_correctly_applied_split_leaves_the_share_count_alone",
      "tests/adversarial/test_stage2_defects.py::test_control_a_correctly_applied_dividend_is_credited_once_on_its_ex_date"
    ],
    "control_note": "the sealed standard is that a class is satisfied only if the clean engine passes AND the mutated engine is caught, so the controls are part of the evidence",
    "every_class_has_a_test": true
  },
  "invariants": {
    "declared_invariant_count": 12,
    "invariants": [
      "CASH_NON_NEGATIVE: cash is never negative at any point in any session",
      "CASH_CONSERVATION: closing cash equals opening cash minus debits plus credits, exactly, in Decimal",
      "CASH_IS_WHOLE_CENTS: cash always has at most two decimal places",
      "NO_LEVERAGE: gross position value never exceeds the declared fraction of equity at the moment of sizing",
      "LONG_ONLY: no position quantity is ever negative",
      "MAX_ONE_RISKY_POSITION: at most one non-cash position is open at any time in Generation 1",
      "ADVERSE_PRICE: every fill price is worse for the account than its reference price",
      "ADVERSE_ROUNDING: every rounding step is adverse to the account",
      "POSITIVE_COST: every fill carries a strictly positive total cost",
      "FILL_AFTER_DECISION: every fill session is strictly later than its decision session",
      "FILL_ON_SESSION: every fill session is an exchange session with a fresh bar for that symbol",
      "NO_POSITION_PAST_LAST_BAR: no position is held past its symbol's final available session"
    ],
    "enforcement": "asserted inside the engine on every event, not checked once at the end; the portfolio reconciles its cash against its ledger after every single movement"
  },
